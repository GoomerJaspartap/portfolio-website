---
const groups = [
  { label: "Languages", tags: ["Java", "Python", "C", "C++", "JavaScript"] },
  { label: "Embedded", tags: ["STM32", "ESP32", "CAN", "RTOS", "Arduino"] },
  { label: "Testing & Tools", tags: ["pytest", "Bazel", "Simulink", "CANoe", "Git"] },
  { label: "Web", tags: ["HTML", "CSS", "JavaScript"] },
];
---

<h2 id="about"><b>➜</b> cat about.txt</h2>

<div class="about-section">
  <div class="about-grid">
    <div class="about-text">
      <p>I'm a Computer Science student at Ontario Tech who likes working where software meets hardware: firmware, control loops, and the test systems that prove they're safe. Right now I'm building SIL test tooling at Rivian and VW, and leading the embedded team on Ontario Tech's Formula SAE electric car.</p>
      <div class="skill-groups">
        {groups.map((group) => (
          <div class="skill-group">
            <small>{group.label}</small>
            <div class="tags">
              {group.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <img
      class="about-img"
      src="/jaspartap-photo.webp"
      alt="Jaspartap Goomer"
      width="600"
      height="400"
    />
  </div>
</div>
