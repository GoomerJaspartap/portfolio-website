---

<section class="max-w-[1100px] mx-auto px-6 sm:px-10 py-16">
  <div class="relative border border-[rgba(255,255,255,0.8)] dark:border-[rgba(255,255,255,0.8)] shadow-lg">
    <!-- Drawing number label -->
    <div class="absolute -top-6 right-0 mono text-xs opacity-70 hidden sm:block">
      DWG NO. JG-2027 · REV E
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px]">
      <!-- Terminal window -->
      <div class="border-b lg:border-b-0 lg:border-r border-[rgba(255,255,255,0.8)]">
        <div class="bg-[#071F3B] dark:bg-[#071F3B]">
          <!-- Terminal header -->
          <div class="border-b border-[rgba(255,255,255,0.8)] px-4 py-2.5 flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-[#FF5F56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27C93F]"></div>
            <span class="mono text-xs opacity-70 ml-3">jaspartap@goomer: ~</span>
          </div>
          
          <!-- Terminal content -->
          <div class="p-8 sm:p-10 mono text-sm leading-relaxed">
            <div class="text-[#7FE0C4]">➜ ~</div>
            <div class="mb-3">whoami</div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight my-2 font-sans tracking-tight">
              Jaspartap Goomer
            </h1>
            
            <div class="text-[#8FB6DE] mb-6">
              # embedded + systems software engineer
            </div>
            
            <div class="mt-6 mb-3 text-[#7FE0C4]">➜ ~</div>
            <div class="mb-1">cat status.txt</div>
            
            <div class="space-y-1 mb-6">
              <div>now&nbsp;&nbsp;&nbsp;&nbsp;= <span class="text-[#FFD58A]">"SW/Systems Intern @ Rivian × VW"</span></div>
              <div>team&nbsp;&nbsp;&nbsp;= <span class="text-[#FFD58A]">"Embedded Lead @ Ontario Tech Racing"</span></div>
              <div>school = <span class="text-[#FFD58A]">"Ontario Tech · BSc CS · 2027"</span></div>
            </div>
            
            <div class="mt-6 mb-3 text-[#7FE0C4]">➜ ~</div>
            <div class="mb-4">open</div>
            
            <div class="flex flex-wrap gap-2 items-center mb-6">
              <a 
                href="/Jaspartap_Goomer_Resume.pdf" 
                download
                class="inline-block bg-white text-[#0E3A6B] border-2 border-white px-4 py-1 text-xs hover:bg-opacity-90 transition-all"
              >
                resume.pdf
              </a>
              <a 
                href="https://github.com/GoomerJaspartap" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block border-2 border-white px-4 py-1 text-xs hover:bg-white hover:text-[#0E3A6B] transition-all"
              >
                github
              </a>
              <a 
                href="https://linkedin.com/in/jaspartapgoomer" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block border-2 border-white px-4 py-1 text-xs hover:bg-white hover:text-[#0E3A6B] transition-all"
              >
                linkedin
              </a>
            </div>
            
            <div class="flex items-center gap-2">
              <span class="text-[#7FE0C4]">➜ ~</span>
              <span class="inline-block w-2 h-4 bg-white animate-pulse"></span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Info blocks -->
      <div class="grid grid-cols-2 lg:grid-cols-1">
        <div class="border-r lg:border-r-0 lg:border-b border-[rgba(255,255,255,0.8)] p-4 lg:p-5">
          <div class="mono text-[10px] tracking-wider opacity-65 mb-2">DISCIPLINE</div>
          <div class="font-medium text-sm lg:text-base">Embedded · Systems · Test</div>
        </div>
        
        <div class="lg:border-b border-[rgba(255,255,255,0.8)] p-4 lg:p-5">
          <div class="mono text-[10px] tracking-wider opacity-65 mb-2">CORE STACK</div>
          <div class="font-medium text-sm lg:text-base">C/C++ · Python · Simulink · CAN</div>
        </div>
        
        <div class="border-r lg:border-r-0 lg:border-b border-[rgba(255,255,255,0.8)] border-t lg:border-t-0 p-4 lg:p-5">
          <div class="mono text-[10px] tracking-wider opacity-65 mb-2">TOOLS</div>
          <div class="font-medium text-sm lg:text-base">pytest · Bazel · CANoe · STM32</div>
        </div>
        
        <div class="p-4 lg:p-5 border-t lg:border-t-0">
          <div class="mono text-[10px] tracking-wider opacity-65 mb-2">SEEKING</div>
          <div class="font-medium text-sm lg:text-base">2027 internships</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .animate-pulse {
      animation: none;
    }
  }
</style>
