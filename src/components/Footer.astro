---
const currentYear = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});
---

<footer class="border-t border-[var(--border)] mt-16">
  <div class="max-w-[1100px] mx-auto px-6 sm:px-10 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm opacity-70">
      <div>
        © {currentYear} Jaspartap Goomer · Built with Astro and Tailwind CSS
      </div>
      <div class="mono text-xs">
        Last updated: {lastUpdated}
      </div>
    </div>
  </div>
</footer>
