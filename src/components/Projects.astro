---
import { getImage } from 'astro:assets';
import bms1 from '../assets/bms1.jpg';
import bms2 from '../assets/bms2.jpg';
import bms3 from '../assets/bms3.jpg';
import bms4 from '../assets/bms4.jpg';
import dash from '../assets/OTR-DASH.png';
import ecu from '../assets/ECU.png';
import oven from '../assets/ReflowOven.png';
import gimbal from '../assets/CameraGimbal.png';

const bms4img = await getImage({ src: bms4, format: 'webp', width: 1200 });
const bms2img = await getImage({ src: bms2, format: 'webp', width: 800 });
const bms3img = await getImage({ src: bms3, format: 'webp', width: 800 });
const bms1img = await getImage({ src: bms1, format: 'webp', width: 800 });
const dashImg = await getImage({ src: dash, format: 'webp', width: 640 });
const ecuImg = await getImage({ src: ecu, format: 'webp', width: 640 });
const ovenImg = await getImage({ src: oven, format: 'webp', width: 640 });
const gimbalImg = await getImage({ src: gimbal, format: 'webp', width: 640 });
---

<h2 id="projects"><b>➜</b> ls ./projects</h2>

<!-- Featured BMS -->
<div class="feat">
  <div class="gal">
    <div class="img g1" style={`background-image:url(${bms4img.src})`}></div>
    <div class="img g2" style={`background-image:url(${bms2img.src})`}></div>
    <div class="img g3" style={`background-image:url(${bms3img.src})`}></div>
    <div class="img g4" style={`background-image:url(${bms1img.src})`}></div>
  </div>
  <div class="fb">
    <div class="flag">FEATURED · FIG. 01</div>
    <h3>./Battery Management System Firmware</h3>
    <div class="org">Ontario Tech Racing · Formula SAE electric car</div>
    <p>Firmware for the Analog Devices LTC6813-1 battery monitor that keeps the car's high-voltage pack safe. I wrote it, then debugged and tested it on the bench.</p>
    <ul>
      <li>Cell voltage and temperature monitoring across the pack</li>
      <li>Passive cell balancing</li>
      <li>Fault detection and error handling</li>
      <li>Microcontroller talks SPI through a transceiver that converts it to isoSPI</li>
      <li>Telemetry over CAN</li>
      <li>Verified with pytest SIL tests and bench HIL setups</li>
    </ul>
    <div class="tags">
      {["C/C++", "LTC6813-1", "isoSPI", "SPI", "CAN", "pytest", "HIL"].map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    <a href="/projects/bms/" class="btn" style="margin-top:14px">Read case study</a>
  </div>
</div>

<!-- Other Projects Grid -->
<div class="grid">
  <div class="proj">
    <div class="img" style={`background-image:url(${dashImg.src})`}></div>
    <div class="pb">
      <h3>FSAE Car Telemetry</h3>
      <p>On-car ESP32 + HMI dashboard reading the ECU over CAN, plus Firebase + TypeScript cloud telemetry.</p>
      <div class="tags">
        {["ESP32", "CAN", "Firebase", "TypeScript"].map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="proj">
    <div class="img" style={`background-image:url(${ecuImg.src})`}></div>
    <div class="pb">
      <h3>ECU & BMS Simulation</h3>
      <p>Behavioural Simulink models for virtual testing, SIL validation and early fault discovery.</p>
      <div class="tags">
        {["Simulink", "SIL", "Stateflow"].map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="proj">
    <div class="img" style={`background-image:url(${ovenImg.src})`}></div>
    <div class="pb">
      <h3>Reflow Oven Controller</h3>
      <p>STM32 control holding ±3°C with a Nextion HMI and ESP32 REST remote control.</p>
      <div class="tags">
        {["STM32", "UART/SPI/I2C", "ESP32"].map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="proj">
    <div class="img" style={`background-image:url(${gimbalImg.src})`}></div>
    <div class="pb">
      <h3>CV Camera Gimbal</h3>
      <p>YOLO + OpenCV face tracking driving a 2-axis gimbal through a PID loop over UART.</p>
      <div class="tags">
        {["Python", "YOLO", "OpenCV", "PID"].map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</div>
