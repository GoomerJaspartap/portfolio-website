---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout 
  title="Battery Management System Firmware | Jaspartap Goomer"
  description="Firmware development for the Analog Devices LTC6813-1 BMS for Ontario Tech Racing's Formula SAE electric car. Cell monitoring, balancing, and safety features."
>
  <Navigation />
  
  <div class="wrap" style="max-width:900px">
    <!-- Header -->
    <div style="margin:40px 0 30px">
      <a href="/#projects" class="btn" style="margin-left:0">← Back to Projects</a>
      
      <div class="flag" style="margin-top:20px">CASE STUDY · FIG. 01</div>
      <h1 style="font-family:'IBM Plex Mono';font-weight:500;font-size:36px;margin:8px 0 12px">
        Battery Management System Firmware
      </h1>
      <div class="org" style="font-size:16px;margin-bottom:14px">
        Ontario Tech Racing · Formula SAE Electric Car
      </div>
      
      <div class="tags">
        {["C/C++", "LTC6813-1", "isoSPI", "SPI", "CAN", "pytest", "HIL"].map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
    
    <!-- Hero Video -->
    <div style="margin-bottom:40px;border:1.5px solid rgba(255,255,255,.8);background:#071F3B">
      <video 
        autoplay 
        muted 
        loop 
        playsinline
        poster="/bms-loop-poster_7f81.jpg"
        style="width:100%;max-width:100%;display:block"
      >
        <source src="/bms-loop_7208.mp4" type="video/mp4" />
      </video>
    </div>
    
    <!-- Overview -->
    <section style="margin-bottom:50px">
      <h2><b>➜</b> cat overview.txt</h2>
      
      <div class="case-content">
        <p>
          For Ontario Tech Racing's Formula SAE electric car, I developed firmware for the Analog Devices LTC6813-1 
          battery management system that monitors and protects the high-voltage battery pack.
        </p>
        
        <p>
          The BMS continuously monitors cell voltages and temperatures across the pack, performs passive cell balancing, 
          and implements fault detection and error handling to ensure driver safety and component protection.
        </p>
      </div>
    </section>
    
    <!-- Implementation -->
    <section style="margin-bottom:50px">
      <h2><b>➜</b> cat implementation.txt</h2>
      
      <div class="case-content">
        <h3>Cell Monitoring</h3>
        <p>
          Implemented continuous voltage and temperature acquisition for all cells in the pack. The microcontroller 
          communicates with the LTC6813-1 via SPI through an isoSPI transceiver.
        </p>
        
        <h3>Passive Cell Balancing</h3>
        <p>
          Developed algorithms to identify cell voltage imbalances and command the LTC6813-1's built-in discharge 
          resistors to balance cells.
        </p>
        
        <h3>Fault Detection & Error Handling</h3>
        <p>
          Built comprehensive error handling for overvoltage, undervoltage, overtemperature, and communication faults.
        </p>
        
        <h3>CAN Telemetry</h3>
        <p>
          Packaged cell voltages, temperatures, and fault status into CAN messages for the vehicle's ECU and dashboard.
        </p>
        
        <h3>Testing & Validation</h3>
        <p>
          Verified firmware behavior through pytest-based Software-in-the-Loop (SIL) tests. Conducted Hardware-in-the-Loop (HIL) 
          testing on bench setups with the actual LTC6813-1 hardware before integration onto the vehicle.
        </p>
      </div>
    </section>
    
    <!-- Hardware Gallery -->
    <section style="margin-bottom:50px">
      <h2><b>➜</b> ls ./hardware</h2>
      
      <div class="case-gallery">
        <div class="case-img-wrap">
          <img 
            src="/bms4_8e2d.jpg" 
            alt="BMS board on the pack"
            loading="lazy"
          />
          <div class="case-caption">BMS board on the pack</div>
        </div>
        
        <div class="case-img-wrap">
          <img 
            src="/bms2_dae8.jpg" 
            alt="BMS board detail"
            loading="lazy"
          />
          <div class="case-caption">BMS board detail</div>
        </div>
        
        <div class="case-img-wrap">
          <img 
            src="/bms3_3e09.jpg" 
            alt="BMS circuitry"
            loading="lazy"
          />
          <div class="case-caption">BMS circuitry</div>
        </div>
        
        <div class="case-img-wrap">
          <img 
            src="/bms1_6bb6.jpg" 
            alt="BMS installation"
            loading="lazy"
          />
          <div class="case-caption">BMS installation</div>
        </div>
      </div>
    </section>
    
    <!-- Back link -->
    <div style="text-align:center;padding:40px 0 80px;border-top:1.5px solid rgba(255,255,255,.8)">
      <a href="/#projects" class="btn">← Back to All Projects</a>
    </div>
  </div>
  
  <footer>
    <div class="wrap">
      © 2026 Jaspartap Goomer · Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> · Last updated {lastUpdated}
    </div>
  </footer>
</Layout>

<style>
  .case-content {
    border: 1.5px solid rgba(255,255,255,.8);
    background: rgba(7,31,59,.5);
    padding: 28px;
  }
  
  .case-content p {
    opacity: .92;
    line-height: 1.65;
    margin-bottom: 18px;
  }
  
  .case-content p:last-child {
    margin-bottom: 0;
  }
  
  .case-content h3 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 16px;
    font-weight: 500;
    margin: 28px 0 10px;
    color: #9FD3FF;
  }
  
  .case-content h3:first-child {
    margin-top: 0;
  }
  
  .case-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  
  .case-img-wrap {
    border: 1.5px solid rgba(255,255,255,.8);
    background: rgba(7,31,59,.5);
    overflow: hidden;
  }
  
  .case-img-wrap img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    filter: grayscale(1) brightness(1.1) sepia(1) hue-rotate(170deg) saturate(2.2);
    mix-blend-mode: screen;
  }
  
  .case-caption {
    padding: 12px 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    opacity: .8;
  }
  
  @media (max-width: 640px) {
    .case-gallery {
      grid-template-columns: 1fr;
    }
    
    .case-content {
      padding: 20px;
    }
    
    video {
      max-width: 100%;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    video[autoplay] {
      autoplay: false;
    }
  }
</style>
